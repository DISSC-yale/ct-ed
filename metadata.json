  "formula": {
    "section": "ecs__",
    "params": {
      "digits": {
        "label": "Number of digits to round to in each step.",
        "category": "Precision",
        "min": 0,
        "max": 7,
        "step_size": 1,
        "value": 2
      },
      "adjustment_digits": {
        "label": "Number of digits to round to for ENGL and MHI adjustment calculations.",
        "category": "Precision",
        "min": 0,
        "max": 7,
        "step_size": 1,
        "value": 6
      },
      "dollar_digits": {
        "label": "Number of digits to round to for dollar amounts.",
        "category": "Precision",
        "min": 0,
        "max": 7,
        "step_size": 1,
        "value": 0
      },
      "final_digits": {
        "label": "Number of digits to round to for the final dollar amounts.",
        "category": "Precision",
        "min": 0,
        "max": 7,
        "step_size": 1,
        "value": 3
      },
      "frlp": {"label": "A. Need weighting factor.", "category": "Primary Weight", "value": 0.3},
      "engl_mhi": {
        "label": "B. Equalized net grand list per capita and median household income threshold.",
        "category": "Primary Weight",
        "step_size": 0.1,
        "value": 1.35
      },
      "engl": {"label": "C. Equalized net grand list per capita weight.", "category": "Primary Weight", "value": 0.7},
      "mhi": {"label": "D. Median household income weight", "category": "Primary Weight", "value": 0.3},
      "non_alliance_min": {
        "label": "E. Non-alliance district minimum aid ratio.",
        "category": "Primary Weight",
        "step_size": 0.01,
        "value": 0.01
      },
      "alliance_min": {
        "label": "F. Non-alliance district minimum aid ratio.",
        "category": "Primary Weight",
        "value": 0.1
      },
      "foundation": {"label": "G. Foundation value.", "category": "Primary Funding", "step_size": 1000, "value": 11525},
      "underfunded": {"label": "H. Adjustment for underfunded districts.", "category": "Primary Funding", "value": 1},
      "overfunded": {"label": "I. Adjustment for overfunded districts.", "category": "Primary Funding", "value": 0},
      "resident": {"label": "Resident student adjustment factor.", "category": "Secondary", "value": 0.6},
      "excess_resident": {
        "label": "Excess resident student adjustment factor.",
        "category": "Secondary",
        "step_size": 0.1,
        "value": 0.15
      },
      "frpl_limit": {"label": "Free & reduced lunch limiter.", "category": "Poverty", "value": 0.75},
      "frpl_concentration": {
        "label": "Free & reduced lunch concentration adjustment factor.",
        "category": "Poverty",
        "step_size": 0.1,
        "value": 0.05
      },
      "ell": {
        "label": "English language literacy adjustment factor.",
        "category": "Secondary",
        "step_size": 0.1,
        "value": 0.25
      },
      "pic": {
        "label": "Public investment communities adjustment factors.",
        "category": "Secondary",
        "step_size": [1, 0.01],
        "reference": "pic_decile",
        "operator": "<=",
        "value": [
          [0, 0],
          [5, 0.06],
          [10, 0.05],
          [15, 0.04],
          [19, 0.03]
        ]
      },
      "regional_bonus": {
        "label": "Regional district bonus weight.",
        "category": "Secondary",
        "step_size": 100,
        "value": 100
      },
      "endowed_bonus": {
        "label": "Endowed Academis bonus weight.",
        "category": "Secondary",
        "step_size": 100,
        "value": 100
      },
      "calculated_prior_after": {
        "label": "Use the calculated rather than provided prior year entitlement after this year.",
        "category": "Precision",
        "value": 2022
      }
    },
    "param_history": {
      "2018": {"underfunded": 0.15, "overfunded": -0.1, "ell": 0.15, "final_digits": 0},
      "2019": {
        "overfunded": 0.25,
        "underfunded": 0.041,
        "ell": 0.15,
        "pic": {
          "reference": "pic_decile",
          "operator": ">",
          "value": [
            [380, 0.06],
            [340, 0.05],
            [310, 0.04],
            [300, 0.03]
          ]
        }
      },
      "2020": {
        "underfunded": 0.1066,
        "overfunded": 0.0833,
        "ell": 0.15,
        "pic": {
          "reference": "pic_decile",
          "operator": ">",
          "value": [
            [380, 0.06],
            [340, 0.05],
            [310, 0.04],
            [300, 0.03]
          ]
        }
      },
      "2021": {"underfunded": 0.1066, "overfunded": 0.0833, "ell": 0.15},
      "2022": {"underfunded": 0.1066},
      "2023": {"underfunded": 0.1667},
      "2024": {"underfunded": 0.2, "final_digits": 0},
      "2025": {"underfunded": 0.565}
    },
    "step_history": {
      "2018": {
        "total_need_students": "d.resident_students+s.frpl_students+s.ell_students+round(s.poverty_concentrated_adj, p.digits)",
        "regional_bonus": "round(d.students_sent_to_regional_district*((d.n_regional_district_grades/13)*p.regional_bonus), p.dollar_digits)",
        "grant_adjustment": "s.fully_funded_grant-(d.actual_fy2017*.78)",
        "entitlement": "s.funding_adjustment+(d.actual_fy2017*.78)"
      },
      "2019": {
        "total_need_students": "d.resident_students+s.frpl_students+s.ell_students+s.poverty_concentrated_adj",
        "regional_bonus": "round(d.students_sent_to_regional_district*((d.n_regional_district_grades/13)*p.regional_bonus), p.dollar_digits)",
        "grant_adjustment": "s.fully_funded_grant-d.actual_fy2017"
      },
      "2020": {
        "total_need_students": "d.resident_students+s.frpl_students+s.ell_students+s.poverty_concentrated_adj",
        "regional_bonus": "round(d.students_sent_to_regional_district*((d.n_regional_district_grades/13)*p.regional_bonus), p.dollar_digits)",
        "grant_adjustment": "s.fully_funded_grant-d.actual_fy2017",
        "more_than_last": "s.fully_funded_grant > d.actual_fy2017"
      },
      "2021": {
        "total_need_students": "d.resident_students+s.frpl_students+s.ell_students+s.poverty_concentrated_adj",
        "regional_bonus": "round(d.students_sent_to_regional_district*((d.n_regional_district_grades/13)*p.regional_bonus), p.dollar_digits)",
        "grant_adjustment": "s.fully_funded_grant-d.actual_fy2017",
        "more_than_last": "s.fully_funded_grant > d.actual_fy2017",
        "entitlement": "!d.alliance_district_flag ? s.entitlement_no_alliance : row_max(d.actual_fy2017, s.entitlement_no_alliance)"
      },
      "2022": {
        "grant_adjustment": "s.fully_funded_grant-d.actual_fy2017",
        "more_than_last": "s.fully_funded_grant > d.actual_fy2017"
      }
    },
    "steps": {
      "prior_entitlement": "s.entitlement|d.prior_entitlement",
      "frpl_students": "round(d.frpl_students*p.frlp, p.digits)",
      "resident_students": "round(d.resident_students*p.resident, p.digits)",
      "high_poverty": "round(limit(d.frpl_students-s.resident_students, 0)*p.excess_resident, p.digits)",
      "poverty_portion": "d.frpl_students/d.resident_students",
      "poverty_limit": "s.poverty_portion > p.frpl_limit ? s.poverty_portion-p.frpl_limit : 0",
      "poverty_concentrated": "d.resident_students*s.poverty_limit",
      "poverty_concentrated_adj": "s.poverty_concentrated*p.frpl_concentration",
      "ell_students": "round(d.ell_students*p.ell, p.digits)",
      "total_need_students": "d.resident_students+s.frpl_students+s.high_poverty+s.ell_students",
      "engl_pc": "round(d.engl_3yr_avg/d.total_population, p.digits)",
      "engl_agg": "round(median(s.engl_pc)*p.engl_mhi, p.digits)",
      "engl_adjustment": "round(s.engl_pc/s.engl_agg, p.adjustment_digits)",
      "mhi_agg": "round(median(d.median_household_income)*p.engl_mhi, p.digits)",
      "mhi_adjustment": "round(d.median_household_income/s.mhi_agg, p.adjustment_digits)",
      "wealth_adjustment_factor": "round(1-((s.engl_adjustment*p.engl)+(s.mhi_adjustment*p.mhi)), p.adjustment_digits)",
      "base_aid_ratio": "limit(s.wealth_adjustment_factor, !d.psd_flag & !d.alliance_district_flag ? p.non_alliance_min : p.alliance_min)",
      "base_aid_ratio_final": "s.base_aid_ratio+p.pic",
      "regional_bonus": "round(d.students_sent_to_regional_district*d.n_regional_district_grades*p.regional_bonus, p.dollar_digits)",
      "endowed_academy_bonus": "round(d.students_sent_to_endowed_academies*d.n_endowed_academy_grades*p.endowed_bonus, p.dollar_digits)",
      "base_aid": "round(s.total_need_students*s.base_aid_ratio_final*p.foundation, p.dollar_digits)",
      "fully_funded_grant": "s.regional_bonus+s.endowed_academy_bonus+s.base_aid",
      "full_grant_harm_held": "!d.alliance_district_flag ? s.fully_funded_grant : row_max(d.actual_fy2017, s.prior_entitlement, s.fully_funded_grant)",
      "grant_adjustment": "s.fully_funded_grant-s.prior_entitlement",
      "more_than_last": "s.fully_funded_grant > s.prior_entitlement",
      "funding_adjustment": "round(s.grant_adjustment*(s.more_than_last ? p.underfunded : p.overfunded), p.final_digits)",
      "entitlement_no_alliance": "s.funding_adjustment+s.prior_entitlement",
      "entitlement": "!d.alliance_district_flag ? s.entitlement_no_alliance : row_max(d.actual_fy2017, s.prior_entitlement, s.entitlement_no_alliance)",
      "change": "s.entitlement-s.prior_entitlement"
    }
  },
